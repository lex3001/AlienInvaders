[remap]

importer="wav"
type="AudioStreamWAV"
uid="uid://$(uuidgen | cut -c1-13)"
path="res://.godot/imported/${f}-$(uuidgen).sample"

[deps]

source_file="res://assets/audio/${f}"
dest_files=["res://.godot/imported/${f}-$(uuidgen).sample"]

[params]

force/8_bit=false
force/mono=false
force/max_rate=false
force/max_rate_hz=44100
edit/trim=false
edit/normalize=false
edit/loop_mode=0
edit/loop_begin=0
edit/loop_end=-1
compress/mode=0
